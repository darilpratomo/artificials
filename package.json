{
  "name": "artificials",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:private && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy --env production",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src shared worker tests *.ts *.json *.jsonc *.md docs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:private": "node scripts/check-private.mjs",
    "sync:benchmarks": "node scripts/sync-benchmarks.mjs",
    "check:academy": "python3 scripts/check-academy.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "fflate": "0.8.3",
    "hono": "4.13.8",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260917.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.2",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
