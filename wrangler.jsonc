{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artificials",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/_private/*",
      "/admin",
      "/admin/*",
      "/admin.md",
      "/Admin.md",
      "/robots.txt",
      "/sitemap.xml",
      "/news",
      "/news/*",
      "/models/*",
    ],
  },
  "vars": {
    "APP_URL": "http://localhost:8787",
    "SUPPORT_EMAIL": "support@artificials.net",
    "ENVIRONMENT": "development",
    "AI_ENABLED": "false",
    "BILLING_ENABLED": "false",
    "PADDLE_ENVIRONMENT": "sandbox",
    "GLOBAL_DAILY_AI_BUDGET_MICROS": "10000000",
  },
  "env": {
    "production": {
      "name": "artificials",
      "workers_dev": true,
      "routes": [{ "pattern": "artificials.net/*", "zone_name": "artificials.net" }],
      "vars": {
        "APP_URL": "https://artificials.net",
        "SUPPORT_EMAIL": "support@artificials.net",
        "ENVIRONMENT": "production",
        "AI_ENABLED": "false",
        "BILLING_ENABLED": "false",
        "PADDLE_ENVIRONMENT": "sandbox",
        "GLOBAL_DAILY_AI_BUDGET_MICROS": "10000000",
      },
    },
  },
  "observability": { "enabled": false },
}
