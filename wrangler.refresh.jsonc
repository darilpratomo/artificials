{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Starts the data refresh workflow on GitHub every three hours, on time.
  // Deploy with `npx wrangler deploy -c wrangler.refresh.jsonc`. It needs the
  // GITHUB_TOKEN secret described in docs/LAUNCH.md.
  "name": "artificials-refresh",
  "main": "worker/refresh.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "triggers": { "crons": ["7 */3 * * *"] },
  "vars": {
    "GITHUB_REPOSITORY": "darilpratomo/artificials",
    "REFRESH_WORKFLOW": "sync-catalog.yml",
  },
  "observability": { "enabled": false },
}
