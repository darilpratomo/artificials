# Local development only. Copy to .dev.vars; never commit or bulk-upload it.
# Set production values and APP_URL separately in Cloudflare. No VITE_ secrets.
# Artificials is free and non-commercial: there are no payment or paid AI settings.
APP_URL=http://localhost:8787
ENVIRONMENT=development
# Supabase: sign-in for site editors and the article database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate: openssl rand -hex 24. Visit /_private/YOUR_VALUE
CMS_PATH_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Set true only after reading your local admin.md and docs/LAUNCH.md.
LEGAL_READY=false
GOOGLE_AUTH_ENABLED=false
SUPPORT_EMAIL=support@artificials.net
OPERATOR_NAME=
OPERATOR_ADDRESS=
PRIVACY_EMAIL=
# /rekrutmen is forwarded to its own PHP server (worker/rekrutmen.ts). Production
# values are Cloudflare Secrets; leave empty locally unless testing against it.
REKRUTMEN_ORIGIN=
REKRUTMEN_PROXY_SECRET=
